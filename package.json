{
  "name": "foreign-anomaly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FOREIGN / 异物 — a first-person anomaly-hunting game set in AI-reconstructed real spaces. Built for the Manycore Aholo Global 3D AI Hackathon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "key:check": "node tools/check-key.mjs",
    "shoot": "node tools/shoot.mjs",
    "assets:plan": "node tools/generate-assets.mjs --dry-run",
    "assets:generate": "node tools/generate-assets.mjs",
    "assets:placeholders": "node tools/build-placeholders.mjs",
    "voxel:check": "node tools/check-voxel.mjs",
    "anchors:build": "node tools/build-anchors.mjs",
    "splat:check": "node tools/probe.mjs --scene room --no-sweep --glb ./assets/foreign/eye.glb",
    "splat:shoot": "node tools/splat-shoot.mjs",
    "record": "node tools/record.mjs",
    "verify": "npm run typecheck && npm run voxel:check && npm run test && npm run build && npm run splat:check && npm run splat:shoot && npm run shoot"
  },
  "dependencies": {
    "@manycore/aholo-viewer": "^1.11.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
