# dependencies
node_modules/

# Build output and captured evidence are committed on purpose: this repository is
# the submission, and the screenshots, the recorded run and the report are work
# that cannot be regenerated by running a command. `dist/` is included so the
# demo can be opened from a clone without a toolchain — `npm run build`
# regenerates it at any time.

# scratch: commit messages, logs, downloaded-once sample data (Aholo's
# open-source bucket) — fetched, not redistributed
.cache/
.DS_Store
*.local
.env
.env.*
# the template is committed on purpose; only real keys stay out
!.env.example
